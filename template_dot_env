# ------------------------------------------------------------------------------
# LibreChat Environment Configuration
#
# Copy this file to .env and fill in the values.
# For more details on configuration, see the official documentation:
# https://www.librechat.ai/docs/configuration/dotenv
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# General Application Settings
# ------------------------------------------------------------------------------

# The title displayed in the web interface.
APP_TITLE=LibreChatViaGoogle

# Comma-separated LibreChat endpoints to expose in the UI/runtime.
# Include `agents` if you want saved Agents and their tool capabilities.
ENDPOINTS=openAI,agents

# ------------------------------------------------------------------------------
# Optional: OpenAI-Compatible Providers
# ------------------------------------------------------------------------------

# OpenCode Zen (OpenAI-compatible) endpoint.
# The shared "public" key can LIST models and run the free "*-free" models, but
# premium models (claude-*, gpt-5*, gemini-*, etc.) require a real OpenCode key.
# Set your own key here for the premium models and higher rate limits.
OPENAI_API_KEY=public
# Verified free models that complete with the public key (refresh from
# https://opencode.ai/zen/v1/models — names change). Add premium models here
# only when OPENAI_API_KEY is a real key.
OPENAI_MODELS=nemotron-3-ultra-free,deepseek-v4-flash-free,mimo-v2.5-free,big-pickle
OPENAI_REVERSE_PROXY=https://opencode.ai/zen/v1
OPENAI_TITLE_MODEL=nemotron-3-ultra-free

# Optional OpenRouter custom endpoint configured in librechat.yaml.
# Even a free OpenRouter key unlocks the "*:free" models (e.g.
# google/gemma-4-31b-it:free). Keep the real key only in your local .env.
OPENROUTER_API_KEY=24389_CHANGE_ME

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------

# The port on which the RAG (Retrieval-Augmented Generation) API service will listen.
# This should match the value in the docker-compose.yml file.
RAG_PORT=8000
BUNDLER_PORT=31234

# ------------------------------------------------------------------------------
# Security & Secrets
#
# IMPORTANT: Change all default "24389_CHANGE_ME" values to strong, unique secrets.
# The start scripts refuse to bring the stack up while placeholder values remain.
# You can generate a secure random key with:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------

# Master key for Meilisearch, the search engine used by LibreChat.
MEILI_MASTER_KEY=24389_CHANGE_ME
# Keep datastore logs concise by default.
MEILI_LOG_LEVEL=WARN

# JSON Web Token secrets for user authentication.
# These must be kept private. Generate two different, strong keys.
JWT_SECRET=24389_CHANGE_ME
JWT_REFRESH_SECRET=24389_CHANGE_ME

# ------------------------------------------------------------------------------
# MongoDB Database Credentials
# ------------------------------------------------------------------------------

# Credentials for the MongoDB root user. This user is only used once for
# the initial setup to create the application database and user.
MONGO_ROOT_USER=24389_CHANGE_ME
MONGO_ROOT_PASSWORD=24389_CHANGE_ME

# Credentials for the application user. LibreChat uses this user to
# connect to and interact with the database.
# Keep MONGO_APP_USER/MONGO_APP_PASSWORD URL-safe (alphanumeric is simplest):
# they are embedded unescaped in the MONGO_URI connection string.
MONGO_APP_USER=24389_CHANGE_ME
MONGO_APP_PASSWORD=24389_CHANGE_ME

# ------------------------------------------------------------------------------
# PostgreSQL (Vector Database) Credentials
# ------------------------------------------------------------------------------

# Credentials for the PostgreSQL database, which is used as a vector store
# for the RAG API.
POSTGRES_DB=24389_CHANGE_ME
POSTGRES_USER=24389_CHANGE_ME
POSTGRES_PASSWORD=24389_CHANGE_ME

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Vertex AI)
# ------------------------------------------------------------------------------

# Path to the Google Cloud service account key file within the container.
# This is mounted as a Docker secret.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_sa
GOOGLE_SERVICE_KEY_FILE=/run/secrets/gcp_sa

# Comma-separated list of available Google AI models to use in LibreChat.
# Vertex supports Gemini 2.5 generally and Gemini 3 in preview on EU endpoints.
GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-pro-preview,gemini-3-flash-preview
# The Google Cloud region where the AI models will be accessed.
# Keep this in a supported EU region (for example: europe-west1, europe-west4, europe-north1).
GOOGLE_LOC=europe-north1

# ------------------------------------------------------------------------------
# RAG API Configuration
# ------------------------------------------------------------------------------

# The provider for generating text embeddings. Default is Google Vertex AI.
EMBEDDINGS_PROVIDER=vertexai

# The specific model to use for embeddings.
EMBEDDINGS_MODEL=text-embedding-004 # default for google

# Whether to extract images from PDF files during processing.
PDF_EXTRACT_IMAGES=True

# ------------------------------------------------------------------------------
# Optional: Firecrawl Scraper
# This service is not enabled by default, as Google's API can handle an equivalent
# to web scraping via its search API.
# ------------------------------------------------------------------------------

# # Your API key for the Firecrawl service.
# FIRECRAWL_API_KEY=your_firecrawl_api_key
# # Optional: Custom Firecrawl API URL if you are self-hosting it.
# FIRECRAWL_API_URL=your_firecrawl_api_url

# ------------------------------------------------------------------------------
# Advanced/Internal Settings
# These are default values that should work for most local setups.
# ------------------------------------------------------------------------------

# Explicit egress proxy used by api/rag_api in docker-compose.yml.
# Keep this on the internal service address unless you intentionally change it.
EGRESS_PROXY_URL=http://egress-proxy:3128

# Docker json-file log rotation applied to all stack containers.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Internal hosts that should bypass proxying.
NO_PROXY=localhost,127.0.0.1,::1,mongodb,chat-mongodb,meilisearch,vectordb,rag_api,sandpack,sandpack-static,caddy-static-proxy,api-proxy,egress-proxy

# Disable telemetry where supported.
DO_NOT_TRACK=1
FIRECRAWL_NO_TELEMETRY=1
HF_HUB_DISABLE_TELEMETRY=1

# ------------------------------------------------------------------------------
# Optional: LibreCodeInterpreter (custom execute_code backend)
# Enabled by adding -f optional/code-interpreter/compose.yml or
# setting ENABLE_CODE_INTERPRETER=1 when using scripts/start_stack.sh.
# ------------------------------------------------------------------------------ 

# LibreChat -> code interpreter API wiring.
# Keep the internal default unless you intentionally route to another backend.
LIBRECHAT_CODE_BASEURL=http://code-interpreter-api:8000
LIBRECHAT_CODE_API_KEY=24389_CHANGE_ME

# Host port for direct health/docs checks from macOS.
CODE_INTERPRETER_PORT=8001

# Pinned upstream commit and resulting local image tag used by the helper script.
CODE_INTERPRETER_GIT_URL=https://github.com/usnavy13/LibreCodeInterpreter.git
CODE_INTERPRETER_GIT_REF=170194fa8e2f5bfb396b76e35d12ce88597a7c47  # dev
CODE_INTERPRETER_IMAGE=librecodeinterpreter:170194f

# Internal object store credentials used by LibreCodeInterpreter.
# LibreCodeInterpreter consumes S3_* settings; the compose overlay maps the
# values below to the bundled MinIO service by default.
CODE_INTERPRETER_MINIO_ACCESS_KEY=24389_CHANGE_ME
CODE_INTERPRETER_MINIO_SECRET_KEY=24389_CHANGE_ME
CODE_INTERPRETER_MINIO_BUCKET=code-interpreter-files
CODE_INTERPRETER_LOG_LEVEL=WARNING
CODE_INTERPRETER_REPL_ENABLED=false
CODE_INTERPRETER_SANDBOX_POOL_ENABLED=false

# ------------------------------------------------------------------------------
# Optional: Local Web Search
# Enabled by adding -f optional/local-search/compose.yml or
# setting ENABLE_LOCAL_SEARCH=1 when using scripts/start_stack.sh.
# Uses official SearXNG, an in-stack Firecrawl API, and a local
# Jina-compatible reranker API.
# ------------------------------------------------------------------------------

# API-side SearX endpoint; defaults to internal auth proxy when local-search overlay is enabled.
SEARXNG_INSTANCE_URL_INTERNAL=http://searxng-auth:8080
# Optional external override retained for compatibility with custom LibreChat configs.
SEARXNG_INSTANCE_URL=http://searxng:8080
SEARXNG_API_KEY=24389_CHANGE_ME
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://searxng:8080/
SEARXNG_SECRET=24389_CHANGE_ME
SEARXNG_IMAGE=searxng/searxng:latest@sha256:3eb2fcb2153e0b1f8e9f3457695ed3db1b1443d1dbc2b6d23121835d33fd50aa
SEARXNG_VALKEY_IMAGE=valkey/valkey:9.0.4-alpine@sha256:d1cc70645bbcef743615463a2fa4616e841407545e18f560aed0c49671a90147

FIRECRAWL_API_KEY=local-firecrawl
FIRECRAWL_API_URL=http://firecrawl-api:3002
# Internal Firecrawl Postgres password. Keep it URL-safe (alphanumeric);
# it is embedded in connection URLs.
FIRECRAWL_POSTGRES_PASSWORD=24389_CHANGE_ME
FIRECRAWL_VERSION=v2
FIRECRAWL_LOG_LEVEL=warn
FIRECRAWL_HARNESS_STARTUP_TIMEOUT_MS=1200000
FIRECRAWL_BULL_AUTH_KEY=24389_CHANGE_ME
FIRECRAWL_MAX_CONCURRENT_JOBS=1
FIRECRAWL_NUM_WORKERS_PER_QUEUE=1
FIRECRAWL_CRAWL_CONCURRENT_REQUESTS=2
FIRECRAWL_BROWSER_POOL_SIZE=1
FIRECRAWL_NUQ_WORKER_COUNT=1
FIRECRAWL_MAX_CONCURRENT_PAGES=2
FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl:latest@sha256:6c5049312506841d85e0bc386da34656630645dca867d72e9a33aa01a1f1b519
FIRECRAWL_PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service:latest@sha256:9e0737bc09df28275aab29726b1c0824a7725113945434e843385d487b7f7ec6
FIRECRAWL_POSTGRES_BASE_IMAGE=postgres:17.9-bookworm@sha256:47f917f7409eacd22fc5dfb1dee634e1b55cf0c01d1a7eb701be2227a03e0641
FIRECRAWL_POSTGRES_SCHEMA_IMAGE=ghcr.io/firecrawl/nuq-postgres:latest@sha256:f9388bd25ae2e1f1d034518236f993ce236173c1d8800ce24092ea6643a95a33
FIRECRAWL_REDIS_IMAGE=redis:8.6.3-alpine@sha256:d146f83b1e0f02fc27c26a50cee39338c736674c5959db84363e6ae3cd9e02d2
FIRECRAWL_RABBITMQ_ERLANG_COOKIE=local-firecrawl-rabbit-cookie
FIRECRAWL_RABBITMQ_IMAGE=rabbitmq:4.3.0-management@sha256:8f3ab1dc6fb3b17ff59ba4e9ceed187c1711a4af831242b733b1e6949625b315

JINA_API_KEY=local-jina
JINA_API_URL=http://jina-reranker:8000/librechat/v1/rerank
JINA_RERANKER_MODEL_NAME=jinaai/jina-reranker-v1-tiny-en
JINA_RERANKER_GIT_URL=https://github.com/freshe/librechat-jina-reranker-api.git
JINA_RERANKER_GIT_REF=da638699215fc89814e623b3163f73dab859885c  # main
JINA_RERANKER_IMAGE=librechat-jina-reranker:da638699-tiny-en
JINA_RERANKER_LOG_LEVEL=WARNING
JINA_RERANKER_MAX_BATCH_SIZE=2
JINA_RERANKER_OMP_NUM_THREADS=1

# Bounded local-search defaults to avoid oversized model/tool context.
LIBRECHAT_WEB_SEARCH_RESULT_COUNT=3
LIBRECHAT_WEB_SEARCH_MAX_SOURCES=2
LIBRECHAT_WEB_SEARCH_HIGHLIGHT_COUNT=2
LIBRECHAT_WEB_SEARCH_SOURCE_CHAR_LIMIT=8000
LIBRECHAT_WEB_SEARCH_SNIPPET_CHAR_LIMIT=300
LIBRECHAT_WEB_SEARCH_HIGHLIGHT_CHAR_LIMIT=350

# The domain for the client and server. These are used for CORS and other
# internal settings. For a local setup, the default is usually correct.
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081

# Browser-facing Sandpack endpoints for artifact/code previews.
# SANDPACK_STATIC_BUNDLER_URL must use a host that still resolves when LibreChat
# prefixes it as "id-<host>" for relay communication.
SANDPACK_BUNDLER_URL=http://127.0.0.1:80
SANDPACK_STATIC_BUNDLER_URL=http://preview.localhost:4324

# Prevents search engines from indexing the site.
NO_INDEX=true

# Specifies the number of trusted reverse proxies in front of the application.
# A value of 1 is the default and correct when running behind a single proxy like Caddy.
# A value of 0 means the application is directly exposed to the internet.
TRUST_PROXY=1
