{
  auto_https disable_redirects
  log {
    level WARN
  }
}

:80 {
  # CORS for Sandpack relay from LibreChat UI (127.0.0.1:3080)
  header {
    # The static preview server is read-only; no write methods.
    # ⚠️ UNVERIFIED against a live browser artifact render (see README TODO).
    # If the preview is blank with a CORS error, restore the old value:
    #   Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Access-Control-Allow-Origin  "*"
    Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Access-Control-Allow-Headers "*"
    Access-Control-Max-Age       "3600"
  }

  @options {
    method OPTIONS
  }
  respond @options 204

  reverse_proxy sandpack-static:4324
}
