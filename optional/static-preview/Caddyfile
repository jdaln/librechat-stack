{
  # no automatic public ACME; we supply our own cert
  auto_https off
}

preview.127.0.0.1.sslip.io, *.127.0.0.1.sslip.io {
  tls /run/secrets/tls_cert /run/secrets/tls_key

  # helpful CORS for Sandpack relay
  header {
    Access-Control-Allow-Origin  "*"
    Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Access-Control-Allow-Headers "Content-Type, Authorization"
    Access-Control-Max-Age       "3600"
  }

  @options {
    method OPTIONS
  }
  respond @options 204

  reverse_proxy sandpack-static:4324
}
