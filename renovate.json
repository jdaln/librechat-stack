{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigests"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "baseBranches": [
    "dev"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "timezone": "UTC",
  "fetchChangeLogs": "pr",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change",
    "Age",
    "Adoption",
    "Passing",
    "Confidence"
  ],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 8,
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "rollbackPrs": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "renovate",
        "major"
      ]
    },
    {
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "groupName": "docker images"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "groupName": "pinned git refs"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "template env image pins"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track CODE_INTERPRETER_GIT_REF in template_dot_env against main branch head",
      "fileMatch": [
        "/^template_dot_env$/"
      ],
      "matchStrings": [
        "CODE_INTERPRETER_GIT_REF=(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "usnavy13/LibreCodeInterpreter",
      "packageNameTemplate": "https://github.com/usnavy13/LibreCodeInterpreter",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track CODE_INTERPRETER_GIT_REF in prepare script against main branch head",
      "fileMatch": [
        "/^scripts\\/prepare_code_interpreter_image\\.sh$/"
      ],
      "matchStrings": [
        "CODE_INTERPRETER_GIT_REF=\"\\$\\{CODE_INTERPRETER_GIT_REF:-(?<currentDigest>[a-f0-9]{40})\\}\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "usnavy13/LibreCodeInterpreter",
      "packageNameTemplate": "https://github.com/usnavy13/LibreCodeInterpreter",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track JINA_RERANKER_GIT_REF in template_dot_env against main branch head",
      "fileMatch": [
        "/^template_dot_env$/"
      ],
      "matchStrings": [
        "JINA_RERANKER_GIT_REF=(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "freshe/librechat-jina-reranker-api",
      "packageNameTemplate": "https://github.com/freshe/librechat-jina-reranker-api",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track JINA_RERANKER_GIT_REF in prepare script against main branch head",
      "fileMatch": [
        "/^scripts\\/prepare_jina_reranker_image\\.sh$/"
      ],
      "matchStrings": [
        "JINA_RERANKER_GIT_REF=\"\\$\\{JINA_RERANKER_GIT_REF:-(?<currentDigest>[a-f0-9]{40})\\}\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "freshe/librechat-jina-reranker-api",
      "packageNameTemplate": "https://github.com/freshe/librechat-jina-reranker-api",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track upstream docker image pins (NAME=repo:tag@digest) in template_dot_env",
      "fileMatch": [
        "/^template_dot_env$/"
      ],
      "matchStrings": [
        "(?:SEARXNG_IMAGE|SEARXNG_VALKEY_IMAGE|FIRECRAWL_IMAGE|FIRECRAWL_PLAYWRIGHT_IMAGE|FIRECRAWL_POSTGRES_BASE_IMAGE|FIRECRAWL_POSTGRES_SCHEMA_IMAGE|FIRECRAWL_REDIS_IMAGE|FIRECRAWL_RABBITMQ_IMAGE)=(?<depName>[a-z0-9][a-z0-9.\\-/]*):(?<currentValue>[a-zA-Z0-9][\\w.\\-]*?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\n"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the code interpreter image pin in the smoke workflow CI env",
      "fileMatch": [
        "/^\\.github\\/workflows\\/stack-smoke\\.yml$/"
      ],
      "matchStrings": [
        "CODE_INTERPRETER_IMAGE=(?<depName>[a-z0-9][a-z0-9.\\-/]*):(?<currentValue>[a-zA-Z0-9][\\w.\\-]*?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\n"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track digest-pinned image build args in docker-compose.yml",
      "fileMatch": [
        "/^docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "(?:EGRESS_PROXY_IMAGE: \\$\\{EGRESS_PROXY_IMAGE:-|LIBRECHAT_IMAGE: )(?<depName>[a-z0-9][a-z0-9.\\-/]*):(?<currentValue>[a-zA-Z0-9][\\w.\\-]*?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\\}\\n]"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
